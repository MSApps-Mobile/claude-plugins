{
  "mcpServers": {
    "zoho-mail": {
      "command": "node",
      "args": ["${user_config.ZOHO_MAIL_MCP_PATH}/dist/index.js"],
      "env": {
        "ZOHO_CLIENT_ID": "${user_config.ZOHO_CLIENT_ID}",
        "ZOHO_CLIENT_SECRET": "${user_config.ZOHO_CLIENT_SECRET}",
        "ZOHO_ACCOUNTS": "${user_config.ZOHO_ACCOUNTS}"
      }
    }
  }
}
